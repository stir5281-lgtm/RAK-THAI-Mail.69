# คัดลอกไฟล์นี้เป็น .env (หรือรัน: npm run init-env) แล้วแก้ไขค่า
PORT=3000
NODE_ENV=development

# ต้องเป็นสตริงสุ่มยาวอย่างน้อย 32 ตัวอักษร (npm run init-env จะสร้างให้อัตโนมัติ)
SESSION_SECRET=61d37e12c6ecf2d015ef804316e87c62b9159581582a4c7a2853a6ffceae4614ff5cb08fce111d6341b38e70040ec33e

# โดเมนอีเมลภายในระบบ
MAIL_DOMAIN=rakthai.dis.th

DB_PATH=./database/rakthai.db

# ตั้งเป็น true เมื่อใช้งานผ่าน HTTPS (คุกกี้จะถูกส่งเฉพาะ HTTPS)
COOKIE_SECURE=false
# ตั้งเป็น true เมื่ออยู่หลัง Reverse Proxy (nginx, Caddy ฯลฯ)
TRUST_PROXY=false

MAX_UPLOAD_MB=5
BCRYPT_ROUNDS=12
